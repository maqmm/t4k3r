SESSION_NAME = '/app/data/session_name'   # path to session file and name, by default '/app/data/session_name', because inside a docker volume
EMOJI_FILE_PATH = '/app/data/data.json'   # path to dict with your added emojis, by default '/app/data/data.json', because inside a docker volume 
API_ID =                             # API ID from https://my.telegram.org/auth?to=apps
API_HASH =                           # API HASH from https://my.telegram.org/auth?to=apps